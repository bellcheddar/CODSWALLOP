# Copy to .env and fill in. Read by codswallop/config.py via python-dotenv.
# .env is gitignored: never commit real server details.

# --- Deploy target (used by deploy/deploy.sh) ---
# SSH destination for rsync, e.g. root@mdeller.com or an ~/.ssh/config alias.
DROPLET_SSH=root@mdeller.com
# Absolute path on the droplet where the code lives (provision.sh creates this).
DROPLET_PATH=/opt/codswallop
# Optional explicit SSH key (else your default agent/key is used).
# SSH_KEY=~/.ssh/id_ed25519

# --- Web serving (used by nginx + gunicorn config) ---
# Public hostname certbot issues a cert for and nginx answers on.
SERVER_NAME=codswallop.mdeller.com
# Address gunicorn binds to (nginx reverse-proxies TLS -> here). 8000-8005 are taken by the
# sibling apps on this droplet: AlphaFraud, ChemSage, ChatPDB, BoltzMaker, FlexAppeal, PANTS.
BIND_ADDR=127.0.0.1:8006

# --- Cache / API knobs (optional; sensible defaults live in config.py) ---
# How long a cached external API response stays fresh, in hours.
# CACHE_TTL_HOURS=168
# How long an assembled family stays fresh before it is rebuilt, in hours.
# FAMILY_TTL_HOURS=168
# Hard cap on entities pulled into one family (protects against "all of the PDB" queries).
# MAX_FAMILY_ENTITIES=1200
