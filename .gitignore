# Managed environment
.venv/
__pycache__/
*.pyc

# Local secrets / deploy target
.env

# SQLite cache and anything downloaded from the APIs. All regenerable: the whole point of
# the cache is that a cold start costs time, not correctness.
data/
codswallop.db
codswallop.db-journal
codswallop.db-wal
codswallop.db-shm

# Generated by the README forge (marcs-vibe-coding) — regenerate with readme_forge.py from
# README.md. Root-anchored so the source templates in codswallop/templates/*.html stay tracked.
/*.html
/*.preview.html
/*.polished.md
/elementor-widget-markdown.css

# macOS
.DS_Store

# Claude Code session transcripts: local working artefacts, ~1 MB each, and this repository
# is public. One was committed to a sibling repo by a `git add -A` that swept up an
# untracked file it should not have.
codswallop-*.txt
*-session.txt
