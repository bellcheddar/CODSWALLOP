# Rebuild every filed family, so a reader never pays for a stale cache.
# Installed to /etc/systemd/system/ by provision.sh; fired by codswallop-warm.timer.
[Unit]
Description=CODSWALLOP cache warm (rebuild every filed family)
After=network-online.target

[Service]
Type=oneshot
User=codswallop
Group=codswallop
WorkingDirectory=/opt/codswallop
EnvironmentFile=-/opt/codswallop/.env
# --no-artefacts because this box cannot build them: biotite, tmtools, PLIP and
# OpenBabel are deliberately absent. It still REPORTS any family left on the
# placeholder map, so a pipeline version bump cannot go unnoticed here even though
# the fix has to happen on a workstation.
ExecStart=/opt/codswallop/.venv/bin/python /opt/codswallop/CODSWALLOP.py warm --force --no-artefacts
# One family can take half a minute cold, and there may be many.
TimeoutStartSec=3600
Nice=10
# Two cores, shared with eight other apps: warming must never starve a live request.
CPUWeight=20
IOWeight=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/codswallop
