<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily sync between this Mac and the droplet.

  launchd rather than cron, for one reason that matters here: this Mac is not a server and
  is frequently asleep at 04:00. `StartCalendarInterval` runs the job at the next wake if
  the machine was asleep when it was due; a cron entry simply misses it and the two machines
  drift for another day.

  Install:
      cp deploy/com.mdeller.codswallop-sync.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.mdeller.codswallop-sync.plist
  Check:
      launchctl list | grep codswallop
      tail -f /tmp/codswallop-sync.log
  Run it now, without waiting:
      launchctl start com.mdeller.codswallop-sync
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mdeller.codswallop-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <!-- Login shell: the script needs ssh with the agent and key config a non-interactive
         shell does not get. -->
    <string>cd /Users/dellboy/Documents/Vibe_Coding/CODSWALLOP &amp;&amp; bash deploy/sync.sh</string>
  </array>

  <!-- 04:10, twenty minutes behind the droplet's own 03:30 warm plus its randomised delay,
       so the droplet has finished refreshing its families before this reads their list. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>10</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/codswallop-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/codswallop-sync.log</string>

  <!-- The job downloads structures and runs DSSP and PLIP. Nice it, so a sync that starts
       while Marc is working does not compete with what he is actually doing. -->
  <key>Nice</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
